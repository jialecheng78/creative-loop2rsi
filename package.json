{
  "name": "creative-loop2rsi-workspace",
  "version": "1.0.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:node": "pnpm -r --if-present test",
    "check": "pnpm run typecheck && pnpm run test:node",
    "start": "pnpm --filter @creative-loop2rsi/desktop start",
    "package:preview": "pnpm --filter @creative-loop2rsi/desktop package:preview",
    "package:release:macos": "pnpm --filter @creative-loop2rsi/desktop package:release:macos"
  }
}
