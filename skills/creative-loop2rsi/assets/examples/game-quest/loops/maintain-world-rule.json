{
  "id": "maintain-world-rule",
  "goal": "交付本任务所需、无互相矛盾且范围最小的世界规则补丁",
  "reads": [
    "quest-brief"
  ],
  "writes": [
    "world-rule-patch"
  ],
  "owner": "world-rule-producer",
  "trigger": {
    "on": [
      "manual",
      "quest-brief.changed"
    ]
  },
  "producer": {
    "agent": "world-rule-producer",
    "separate_from_judges": true
  },
  "judges": [
    "world-consistency",
    "quest-taste-gate"
  ],
  "decision_policy": [
    "hard-block",
    "needs-taste",
    "revise",
    "commit"
  ],
  "memory_updates": [
    "confirmed-facts",
    "finding-index"
  ],
  "retry_budget": {
    "max_attempts": 3,
    "max_no_improvement": 2,
    "on_budget_exhausted": "escalate"
  },
  "stop_conditions": [
    "retry-budget-exhausted",
    "no-improvement-twice"
  ],
  "human_gate": {
    "required": true,
    "when": "before-commit"
  }
}
