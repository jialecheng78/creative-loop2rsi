{
  "id": "write-quest-dialogue",
  "goal": "交付遵守世界规则、可直接实现且不替玩家解释谜底的任务对白",
  "reads": [
    "quest-brief",
    "world-rule-patch",
    "quest-outline"
  ],
  "writes": [
    "quest-dialogue"
  ],
  "owner": "dialogue-producer",
  "trigger": {
    "on": [
      "manual",
      "quest-brief.changed",
      "world-rule-patch.changed",
      "quest-outline.changed"
    ]
  },
  "producer": {
    "agent": "dialogue-producer",
    "separate_from_judges": true
  },
  "judges": [
    "world-consistency",
    "quest-playability",
    "quest-taste-gate"
  ],
  "decision_policy": [
    "hard-block",
    "needs-taste",
    "warn-and-revise",
    "commit"
  ],
  "memory_updates": [
    "run-lessons",
    "finding-index"
  ],
  "retry_budget": {
    "max_attempts": 3,
    "max_no_improvement": 2,
    "on_budget_exhausted": "escalate"
  },
  "stop_conditions": [
    "retry-budget-exhausted",
    "no-improvement-twice"
  ],
  "human_gate": {
    "required": true,
    "when": "before-release"
  }
}
