{
  "schema_version": "0.1",
  "kind": "LoopSpec",
  "id": "design-quest-structure",
  "goal": "交付包含目标、阻碍、两个选择及可实现后果的任务结构",
  "reads": [
    "quest-brief",
    "world-rule-patch"
  ],
  "writes": [
    "quest-outline"
  ],
  "owner": "quest-structure-producer",
  "trigger": {
    "on": [
      "manual",
      "quest-brief.changed",
      "world-rule-patch.changed"
    ]
  },
  "producer": {
    "agent": "quest-structure-producer",
    "separate_from_judges": true
  },
  "judges": [
    "world-consistency",
    "quest-playability",
    "quest-taste-gate"
  ],
  "decision_policy": [
    "hard-block",
    "needs-taste",
    "warn-and-revise",
    "commit"
  ],
  "memory_updates": [
    "run-lessons",
    "finding-index"
  ],
  "retry_budget": {
    "max_attempts": 3,
    "max_no_improvement": 2,
    "on_budget_exhausted": "escalate"
  },
  "stop_conditions": [
    "retry-budget-exhausted",
    "no-improvement-twice"
  ],
  "human_gate": {
    "required": true,
    "when": "before-commit"
  }
}
