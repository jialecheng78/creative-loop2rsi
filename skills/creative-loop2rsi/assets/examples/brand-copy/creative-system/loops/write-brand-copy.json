{
  "schema_version": "0.1",
  "kind": "LoopSpec",
  "id": "write-brand-copy",
  "goal": "交付标题、45–90 字正文和温和行动邀请，并满足品牌硬合同",
  "reads": [
    "copy-brief"
  ],
  "writes": [
    "brand-copy"
  ],
  "owner": "copy-producer",
  "trigger": {
    "on": [
      "manual",
      "copy-brief.changed"
    ]
  },
  "producer": {
    "agent": "copy-producer",
    "separate_from_judges": true
  },
  "judges": [
    "brand-hard-contract",
    "brand-quality-shadow",
    "brand-taste-gate"
  ],
  "decision_policy": [
    "hard-block",
    "needs-taste",
    "warn-and-revise",
    "commit"
  ],
  "memory_updates": [
    "confirmed-preferences",
    "run-lessons",
    "finding-index"
  ],
  "retry_budget": {
    "max_attempts": 3,
    "max_no_improvement": 2,
    "on_budget_exhausted": "escalate"
  },
  "stop_conditions": [
    "retry-budget-exhausted",
    "no-improvement-twice"
  ],
  "human_gate": {
    "required": true,
    "when": "before-release"
  }
}
